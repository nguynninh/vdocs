// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// "prisma-client" (the v7 default) emits raw .ts source with .js-extension
// relative imports, which only resolves after a tsc build step. This project
// runs TypeScript directly via `node --experimental-strip-types` with no
// build step, so we use the classic compiled-JS generator instead.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  provider       String
  providerUserId String
  name           String
  email          String?
  avatar         String?
  mobile         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  ownedDocuments    Document[]        @relation("DocumentOwner")
  documentMembers   DocumentMember[]
  createdShareLinks ShareLink[]
  documentVersions  DocumentVersion[]
  documentViews     DocumentView[]
  uploadedFiles     DocumentFile[]
  favoriteDocuments DocumentFavorite[]

  @@unique([provider, providerUserId])
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String   @default("briefcase")
  ownerId     String
  createdAt   DateTime @default(now())

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  documents Document[]
}

model WorkspaceMember {
  id          String @id @default(uuid())
  workspaceId String
  userId      String
  role        String @default("MEMBER") // OWNER | MEMBER

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model Document {
  id             String    @id @default(uuid())
  workspaceId    String
  parentId       String?
  ownerId        String
  order          Float     @default(0)
  title          String    @default("Untitled")
  icon           String?
  ydocState      Bytes?
  contentVersion Int       @default(0)
  linkAccess     String    @default("NONE") // NONE | VIEWER | EDITOR
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent     Document?         @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Document[]        @relation("DocumentTree")
  owner      User              @relation("DocumentOwner", fields: [ownerId], references: [id])
  members    DocumentMember[]
  shareLinks ShareLink[]
  versions   DocumentVersion[]
  views      DocumentView[]
  files      DocumentFile[]
  favoritedBy DocumentFavorite[]

  @@index([parentId])
}

// Per-user bookmark of a document, surfaced in the sidebar/dashboard.
model DocumentFavorite {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([userId])
}

// A file attached/embedded via the editor's "/file" block. Bytes live on
// disk under uploads/, named `${id}-${originalName}`; this row is only the
// metadata needed to render and download it.
model DocumentFile {
  id         String   @id @default(uuid())
  documentId String
  filename   String
  mimeType   String
  size       Int
  storedName String
  uploadedBy String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])

  @@index([documentId])
}

// One row per (viewer, day), upserted with an incrementing `count` — repeat
// page loads within the same day bump `count` on the existing row instead of
// creating new ones, so the analytics tab can chart both total views
// (sum of count) and unique viewers (distinct rows) per day without
// unbounded row growth.
model DocumentView {
  id         String   @id @default(uuid())
  documentId String
  viewerId   String
  viewDate   String // "YYYY-MM-DD", server-local — the dedup key
  count      Int      @default(1)
  lastViewedAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id])

  @@unique([documentId, viewerId, viewDate])
  @@index([documentId, viewDate])
}

// Periodic checkpoints of a document's Yjs state, so past content can be
// listed, previewed, and restored. Auto snapshots are throttled (see
// documentRoomManager.ts); manual ones are always created on request.
model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  ydocState      Bytes
  contentVersion Int
  trigger        String // "auto" | "manual"
  label          String?
  createdBy      String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [createdBy], references: [id])

  @@index([documentId, createdAt])
}

// The public, revocable stand-in for a document's real UUID. Copying a
// share link hands out `token`, never `documentId` — so revoking access
// just means flipping `isActive`, and the real ID never has to be rotated.
model ShareLink {
  id         String    @id @default(uuid())
  token      String    @unique
  documentId String
  isActive   Boolean   @default(true)
  createdBy  String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])
}

model DocumentMember {
  id         String @id @default(uuid())
  documentId String
  userId     String
  role       String // EDITOR | VIEWER

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
}
